@page "/CreateFaq"
@using Aufguss.Models
@using System.Text.Json.Nodes
@using System.Text.Json

<div class="row mb-5">
    <div class="col-lg-8">
        <h1 class=mb-5>Lägg till FAQ</h1>


        <div class="row mb-3">
            <label class="col-md-4 col-form-label">Fråga</label>
            <div class="col-md-8">
                <input class="form-control" @bind="FaqDtoData.Question">
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-md-4 col-form-label">Svar</label>
            <div class="col-md-8">
                <textarea rows="4" class="form-control" @bind="FaqDtoData.Answer"></textarea>
            </div>
        </div>

        <div class="row">
            <div class="offset-md-4 col-md-4 d-grid">
                <button class="btn btn-primary" @onclick="SaveFaq">Spara</button>
            </div>
            <div class="col-md-4 d-grid">
                <a class="btn btn-outline-primary" href="/CreateFaq">Avbryt</a>
            </div>
        </div>
    </div>
</div>

<p></p>
@if (faqs == null)
{
    <p><em>Laddar...</em></p>
}

else
{
    <div class="accordion" id="accordionExample">
        @foreach (var faq in faqs)
        {
            <div class="container mb-3">
                <div class="row flex-column flex-md-row align-items-start">
                    <!-- Top Buttons (Up/Down) -->
                    <div class="col-12 col-md-auto mb-2 mb-md-0 text-center mt-2">
                        @if (faq.Position > 0)
                        {
                            <button class="btn btn-success btn-sm me-1" @onclick="async () => await EditFaq(faq.Id, -1)">↑</button>
                        }
                        else
                        {
                            <button class="btn btn-danger btn-sm me-1" disabled>↑</button>
                        }
                        @if (faq.Position < faqs.Count - 1)
                        {
                            <button class="btn btn-primary btn-sm me-1" @onclick="async () => await EditFaq(faq.Id, 1)">↓</button>
                        }
                        else
                        {
                            <button class="btn btn-danger btn-sm me-1" disabled>↓</button>
                        }
                    </div>

                    <!-- Accordion -->
                    <div class="col-12 col-md-8 ">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading@count">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@count" aria-expanded="false" aria-controls="collapse@count">
                                    @faq.Question
                                </button>
                            </h2>
                            <div id="collapse@count" class="accordion-collapse collapse" aria-labelledby="heading@count" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    - @faq.Answer
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Buttons (Delete/Edit) -->
                    <div class="col-12 col-md-auto mt-md-2 text-center mt-2">
                        <button class="btn btn-warning btn-sm" @onclick="async () => await EditAlert(faq.Id)">Ändra</button>
                        <button class="btn btn-danger btn-sm me-1" @onclick="async () => await ShowRemoveAlert(faq.Id)">Ta bort</button>
                    </div>
                </div>
            </div>
            count++;
        }
    </div>
