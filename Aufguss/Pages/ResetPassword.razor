@page "/reset-password"
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Välj ett nytt lösenord</h3>

@if (!string.IsNullOrEmpty(successMessage))
{
    <p>@successMessage</p>
}
else
{
    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
        <InputText type="password" class="form-control mt-3" @bind-Value="model.NewPassword" placeholder="Nytt lösenord" />
        <button type="submit" class="btn btn-primary mt-3">Spara nytt lösenord</button>
    </EditForm>
}

@code {
    private ResetPasswordModel model = new();
    private string successMessage;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        model.Email = query["email"];
        model.Token = query["token"];
        Console.WriteLine($"Token captured from URL: {model.Token}");
    }

    private async Task HandleSubmit()
    {
        var response = await Http.PostAsJsonAsync("api/auth/reset-password", model);
        if (response.IsSuccessStatusCode)
            successMessage = "Lösenordet har återställts. Du kan nu logga in.";
        else
            successMessage = "Något gick fel, försök igen.";
    }

    private class ResetPasswordModel
    {
        public string Email { get; set; }
        public string Token { get; set; }
        public string NewPassword { get; set; }
    }
}
