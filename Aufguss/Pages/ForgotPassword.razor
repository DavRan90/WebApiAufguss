@page "/forgot-password"
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Återställ lösenord</h3>

<EditForm Model="@model" OnValidSubmit="HandleSubmit">
    <div class="form-group">
        <InputText class="form-control" @bind-Value="model.Email" placeholder="Ange din e-postadress" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Skicka återställningslänk</button>
</EditForm>

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private ForgotPasswordModel model = new();
    private string message;

    private async Task HandleSubmit()
    {
        var response = await Http.PostAsJsonAsync("api/auth/forgot-password", model);

        if (response.IsSuccessStatusCode)
            message = "Om e-postadressen finns registrerad har ett mail skickats med instruktioner.";
        else
            message = "Något gick fel, försök igen.";
    }

    private class ForgotPasswordModel
    {
        public string Email { get; set; }
    }
}
