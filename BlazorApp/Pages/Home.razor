@page "/"

<PageTitle>Startsida</PageTitle>



<h1>Aufguss på Freja Bad & Gym</h1>

@if(entries == null)
{
    <p><em>Laddar...</em></p>
}

else
{
    foreach(var entry in entries)
    {
        <h3 class="mt-5 mb-3">@entry.Title</h3>
        <div class="container-fluid">
            <div class="row">
                <div class="col-4 border border-1">
                    @* @if (!string.IsNullOrEmpty(base64Image)) *@

                    <img src="@String.Concat(@fileLocation + @entry.Image)" alt="@entry.Image" style="max-width: 300px;" />

                    @* else
                    {
                        <p>Ingen bild...</p>
                    } *@
                </div>
                <div class="col-6 border border-1">@entry.Description</div>

                <div class="col-2 border border-1">
                    <button class="btn btn-danger" @onclick="async () => await DeleteEntry(entry.Id)">Ta bort</button>
                </div>
            </div>
        </div>
    }

}


@inject HttpClient http

@code {
    private List<Entry>? entries;

    private string base64Image;

    private string imagePathFromDb = "";
    private string fileLocation = "";


    protected override async Task OnInitializedAsync()
    {
        entries = await http.GetFromJsonAsync<List<Entry>>("api/Entries");

        fileLocation = $"https://localhost:7162/api/upload/";

    

        // var fileName = "flower.jpg"; // from DB or wherever
        // var response = await http.GetAsync($"api/upload/{fileName}");

        // if (response.IsSuccessStatusCode)
        // {
        //     var imageBytes = await response.Content.ReadAsByteArrayAsync();
        //     base64Image = $"data:image/jpeg;base64,{Convert.ToBase64String(imageBytes)}";
        // }
    }

    private async Task DeleteEntry(int id)
    {
        await http.DeleteAsync("api/Entries/" + id);
        entries = await http.GetFromJsonAsync<List<Entry>>("api/Entries");
    }
}